{
  "name": "@psacc/api",
  "version": "0.1.0",
  "private": true,
  "description": "PSA Control Center — Control Plane API (NestJS)",
  "type": "module",
  "files": ["dist", "migrations", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env --clear-screen=false src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file=.env src/database/cli.ts migrate",
    "db:seed": "tsx --env-file=.env src/database/cli.ts seed",
    "db:status": "tsx --env-file=.env src/database/cli.ts status",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:milestone": "vitest run --config vitest.milestone.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@peculiar/x509": "1.12.3",
    "@psacc/contracts": "workspace:*",
    "cookie-parser": "1.4.7",
    "fflate": "0.8.2",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
