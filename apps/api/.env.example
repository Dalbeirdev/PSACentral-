# PSA Control Center API — environment template.
# Local development: run `pnpm setup` to generate a real .env with random secrets (never commit it).
# Staging/production: inject these from a secret manager; the API refuses unsafe values at boot.

# development | test | staging | production
APP_ENV=development
HOST=127.0.0.1
PORT=4210
LOG_LEVEL=info                      # debug | info | warn | error
TRUST_PROXY=loopback                # Express trust-proxy setting for the web tier / reverse proxy
APP_ALLOWED_ORIGINS=http://localhost:3210,http://127.0.0.1:3210   # https:// only in staging/production
OPENAPI_ENABLED=true                # serve /api/docs (keep false in production)

# Security policy
AUTH_MFA_REQUIRED=false             # MUST be true in staging/production (enforced)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10      # per IP, credential endpoints
RATE_LIMIT_PER_MINUTE=300           # per IP, everything else

# Secrets (base64). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CSRF_SECRET=<base64, >= 32 bytes>
DATA_ENCRYPTION_KEY=<base64, exactly 32 bytes — AES-256-GCM key for secrets at rest>
LICENSE_SIGNING_KEY=<base64, exactly 32 bytes — Ed25519 seed that signs appliance license tokens (Module 16)>

# Database. The API must use the least-privilege login (member of psacc_app_rw, NOBYPASSRLS).
DATABASE_URL=postgres://psacc_app:<password>@127.0.0.1:55432/psacc_dev
# Schema owner — used only by `pnpm db:migrate` / `db:seed`, never by the running API.
MIGRATION_DATABASE_URL=postgres://psacc_owner:<password>@127.0.0.1:55432/psacc_dev
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Automated tests (isolated databases; reset on every run)
TEST_DATABASE_URL=postgres://psacc_app:<password>@127.0.0.1:55432/psacc_test
TEST_MIGRATION_DATABASE_URL=postgres://psacc_owner:<password>@127.0.0.1:55432/psacc_test
E2E_DATABASE_URL=postgres://psacc_app:<password>@127.0.0.1:55432/psacc_e2e
E2E_MIGRATION_DATABASE_URL=postgres://psacc_owner:<password>@127.0.0.1:55432/psacc_e2e

# Synthetic seed users' password — development/test only (refused in staging/production)
SEED_DEFAULT_PASSWORD=<generated>

# --- Deployment packages (Module 5) ---
# Standard PSA Edge image referenced by every generated package (one image for all clients).
EDGE_IMAGE_REPOSITORY=psacc/psa-edge
EDGE_IMAGE_VERSION=0.1.0
# sha256:<64 hex> of the signed, published image. Required in staging/production.
EDGE_IMAGE_DIGEST=
# Agent gateway (mTLS, Module 7) that edge agents dial out to. https only; public address in staging/production.
AGENT_GATEWAY_URL=https://localhost:8443
EDGE_HEARTBEAT_SECONDS=60
PACKAGE_RATE_LIMIT_PER_MINUTE=30

# --- Agent gateway (Module 7) ---
# Separate HTTPS listener for edge agents: enrollment with the single-use token, then mutual TLS.
AGENT_GATEWAY_ENABLED=true
# Containers on another host (or in WSL Docker) reach the gateway on a routable address: set
# AGENT_GATEWAY_HOST=0.0.0.0 and AGENT_GATEWAY_URL=https://<host address>:8443 for such tests.
AGENT_GATEWAY_HOST=127.0.0.1
# AGENT_GATEWAY_PORT defaults to the port of AGENT_GATEWAY_URL.
AGENT_GATEWAY_EXTRA_NAMES=
AGENT_CERT_DAYS=90
AGENT_ENROLL_RATE_PER_MINUTE=20
