#!/usr/bin/env bash
# PSA Edge appliance upgrade — {{deploymentCode}}.
# Applies an image upgrade that the Control Plane issued as a signed remote command and that this
# appliance's agent verified and staged. The appliance has no Docker socket by design, so the image
# change happens here, on the host, under your control. Data volumes and secrets are untouched; the
# agent reports the new version to the Control Plane by itself.
#
# Usage: scripts/upgrade.sh [--production] [--image <repository:version[@sha256:digest]>]
#   Without --image the staged order written by the agent is used (and must exist).
set -euo pipefail
cd "$(dirname "$0")/.."

PROFILE=development
IMAGE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --production) PROFILE=production ;;
    --image) shift; IMAGE="${1:-}" ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done
COMPOSE=(docker compose -f compose.yaml)
if [ "$PROFILE" = production ]; then COMPOSE+=(-f compose.production.yaml); fi

step() { printf '\n==> %s\n' "$1"; }
fail() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }

step "Checking prerequisites"
command -v docker >/dev/null 2>&1 || fail "Docker is not installed on this host."
docker info >/dev/null 2>&1 || fail "Docker Engine is not running, or this user may not use it."
[ -f .env ] || fail "No .env in this directory: run scripts/install.sh first."

if [ -z "$IMAGE" ]; then
  step "Reading the staged upgrade order from the appliance"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  if ! "${COMPOSE[@]}" cp edge-agent:/var/log/psa-edge/remote/upgrade-order.json "$tmp/order.json" >/dev/null 2>&1; then
    fail "No staged upgrade order was found. Issue 'Upgrade appliance image' in the dashboard first, or pass --image explicitly."
  fi
  ORDER="$(cat "$tmp/order.json")"
  IMAGE="$(printf '%s' "$ORDER" | sed -n 's/.*"image": *"\([^"]*\)".*/\1/p')"
  EXPIRES="$(printf '%s' "$ORDER" | sed -n 's/.*"expiresAt": *"\([^"]*\)".*/\1/p')"
  [ -n "$IMAGE" ] || fail "The staged order is unreadable."
  if exp=$(date -u -d "$EXPIRES" +%s 2>/dev/null) && [ "$(date -u +%s)" -ge "$exp" ]; then
    fail "The staged order expired at $EXPIRES. Issue the upgrade again in the dashboard."
  fi
  echo "  staged image: $IMAGE"
fi
printf '%s' "$IMAGE" | grep -Eq '^[a-z0-9]+([._/-][a-z0-9]+)*:[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?(@sha256:[0-9a-f]{64})?$' || fail "Not a valid image reference: $IMAGE"
REPO="${IMAGE%%:*}"
EXPECTED_REPO="{{edgeImageRef}}"; EXPECTED_REPO="${EXPECTED_REPO%%:*}"
[ "$REPO" = "$EXPECTED_REPO" ] || fail "The image repository ($REPO) differs from this appliance's ($EXPECTED_REPO)."
if [ "$PROFILE" = production ] && ! printf '%s' "$IMAGE" | grep -q '@sha256:'; then
  fail "Production appliances only run images pinned by digest."
fi

step "Pulling $IMAGE"
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  docker pull "$IMAGE" || fail "The image could not be pulled. For an air-gapped host, load it with 'docker load -i' first."
fi
case "$IMAGE" in
  *@sha256:*)
    want="${IMAGE##*@}"
    docker image inspect "$IMAGE" --format '{{ .RepoDigests }}' | grep -q "$want" || fail "The pulled image does not carry the expected digest."
    ;;
esac

step "Recording the image in .env and recreating the services"
if grep -q '^PSA_EDGE_IMAGE=' .env; then
  sed -i.bak "s#^PSA_EDGE_IMAGE=.*#PSA_EDGE_IMAGE=$IMAGE#" .env && rm -f .env.bak
else
  printf '\nPSA_EDGE_IMAGE=%s\n' "$IMAGE" >> .env
fi
"${COMPOSE[@]}" up -d --remove-orphans
"${COMPOSE[@]}" ps

step "Done"
echo "The appliance now runs $IMAGE. The agent verifies the running version and reports the result to the Control Plane within its next heartbeat."
echo "Roll back with: scripts/upgrade.sh --image <previous image>"
