# PSA Edge appliance — {{deploymentCode}} · {{clientComment}}
# Package {{packageNumber}}, generated {{generatedAt}} by PSA Control Center. Do not edit this file;
# change the deployment in the dashboard and generate a new package instead.
#
# This file runs the standard, versioned PSA Edge image. It is not an image itself.
# All operational data (tickets, PSA credentials, integration logs) stays on this host in the
# named volumes below; nothing in this project publishes the database to the network.
name: {{projectName}}

x-edge-image: &edge-image "${PSA_EDGE_IMAGE:-{{edgeImageDefault}}}"

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

x-edge-service: &edge-service
  image: *edge-image
  user: "10001:10001"
  read_only: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  tmpfs: ["/tmp:size=16m,mode=1777"]
  restart: unless-stopped
  environment:
    PSA_EDGE_CONFIG: /etc/psa-edge/edge.json
    PSA_EDGE_DB_HOST: edge-postgres
    PSA_EDGE_DB_NAME: psa_edge
    PSA_EDGE_SECRETS_DIR: /run/secrets
    PSA_EDGE_PSA_TEST_INTERVAL: "${PSA_EDGE_PSA_TEST_INTERVAL:-15m}"
    PSA_EDGE_SYNC_INTERVAL: "${PSA_EDGE_SYNC_INTERVAL:-5m}"
    HTTPS_PROXY: "${HTTPS_PROXY:-}"
    NO_PROXY: "${NO_PROXY:-localhost,127.0.0.1,edge-postgres}"
  logging: *logging

services:
  # Operational database for this client only. No host port is published.
  edge-postgres:
    image: "${PSA_POSTGRES_IMAGE:-postgres:17-alpine}"
    restart: unless-stopped
    environment:
      POSTGRES_DB: psa_edge
      POSTGRES_USER: psa_edge_owner
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_owner_password
      POSTGRES_INITDB_ARGS: "--data-checksums --auth-host=scram-sha-256 --auth-local=scram-sha-256"
      PGDATA: /var/lib/postgresql/data/pgdata
    secrets: [postgres_owner_password]
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks: [edge-internal]
    cap_drop: [ALL]
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    security_opt: ["no-new-privileges:true"]
    shm_size: 128mb
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U psa_edge_owner -d psa_edge"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s
    logging: *logging

  # One-shot schema management: creates roles and tables, applies migrations, then exits.
  edge-migrate:
    <<: *edge-service
    command: ["edge-migrate", "up"]
    restart: "no"
    depends_on:
      edge-postgres:
        condition: service_healthy
    secrets: [postgres_owner_password, app_db_password, inspector_db_password]
    volumes:
      - ./config/edge.json:/etc/psa-edge/edge.json:ro
    networks: [edge-internal]

  # Application API and the local administration / setup UI (this host only).
  edge-api:
    <<: *edge-service
    command: ["edge-api"]
    depends_on:
      edge-migrate:
        condition: service_completed_successfully
    secrets: [app_db_password, data_key]
    ports:
      - "127.0.0.1:${EDGE_LOCAL_ADMIN_PORT:-{{localAdminPort}}}:8480"
    volumes:
      - ./config/edge.json:/etc/psa-edge/edge.json:ro
      - ./config/license.json:/etc/psa-edge/license.json:ro
      - edge-logs:/var/log/psa-edge
    networks: [edge-internal, edge-egress]
    healthcheck:
      test: ["CMD", "edge-api", "healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s

  # PSA integration adapter ({{psaProviderName}}), ticket management and synchronization.
  # It calls the PSA API directly from this host.
  edge-worker:
    <<: *edge-service
    command: ["edge-worker"]
    depends_on:
      edge-migrate:
        condition: service_completed_successfully
    secrets: [app_db_password, data_key]
    volumes:
      - ./config/edge.json:/etc/psa-edge/edge.json:ro
      - ./config/license.json:/etc/psa-edge/license.json:ro
      - edge-logs:/var/log/psa-edge
    networks: [edge-internal, edge-egress]

  # Monitoring and management agent. Outbound-only connection to the Control Plane; it reports
  # approved health and metadata, never ticket content or credentials.
  edge-agent:
    <<: *edge-service
    command: ["edge-agent"]
    depends_on:
      edge-migrate:
        condition: service_completed_successfully
    secrets: [inspector_db_password]
    volumes:
      - ./config/edge.json:/etc/psa-edge/edge.json:ro
      - ./config/license.json:/etc/psa-edge/license.json:ro
      - ./enrollment/enrollment.json:/etc/psa-edge/enrollment.json:ro
      - agent-state:/var/lib/psa-edge-agent
      - edge-logs:/var/log/psa-edge
    networks: [edge-internal, edge-egress]

  # Local database backups (pg_dump) into the edge-backups volume, recorded in backup_runs.
  edge-backup:
    image: "${PSA_POSTGRES_IMAGE:-postgres:17-alpine}"
    restart: unless-stopped
    depends_on:
      edge-migrate:
        condition: service_completed_successfully
    entrypoint: ["/bin/sh", "/opt/psa-edge/edge-backup.sh"]
    environment:
      PGHOST: edge-postgres
      PGDATABASE: psa_edge
      PGUSER: psa_edge_owner
      BACKUP_INTERVAL_HOURS: "${EDGE_BACKUP_INTERVAL_HOURS:-24}"
      BACKUP_RETENTION: "${EDGE_BACKUP_RETENTION:-7}"
      BACKUP_INITIAL_DELAY_SECONDS: "${EDGE_BACKUP_INITIAL_DELAY_SECONDS:-60}"
    secrets: [postgres_owner_password]
    volumes:
      - ./scripts/edge-backup.sh:/opt/psa-edge/edge-backup.sh:ro
      - edge-backups:/backups
    networks: [edge-internal]
    read_only: true
    tmpfs: ["/tmp:size=16m"]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    logging: *logging

networks:
  edge-internal:
    internal: true
  edge-egress: {}

volumes:
  pgdata: {}
  edge-logs: {}
  edge-backups: {}
  agent-state: {}

# Generated on this host by scripts/install.sh or scripts/install.ps1. Never part of the package.
secrets:
  postgres_owner_password:
    file: ./secrets/postgres_owner_password
  app_db_password:
    file: ./secrets/app_db_password
  inspector_db_password:
    file: ./secrets/inspector_db_password
  data_key:
    file: ./secrets/data_key
