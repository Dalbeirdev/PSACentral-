# Optional local settings for {{deploymentCode}}. The install script copies this file to ".env"
# next to compose.yaml the first time it runs; Docker Compose reads it automatically.
# Never put passwords or PSA credentials here: secrets are generated in ./secrets, and PSA
# credentials are entered in the local admin UI.

# Port of the local administration and setup UI (bound to 127.0.0.1 only).
EDGE_LOCAL_ADMIN_PORT={{localAdminPort}}

# Image overrides. Production installs must pin both images by digest (repository@sha256:...).
# PSA_EDGE_IMAGE={{edgeImageDefault}}

# How often the worker re-tests the PSA connection and synchronizes tickets (Go durations).
# PSA_EDGE_PSA_TEST_INTERVAL=15m
# PSA_EDGE_SYNC_INTERVAL=5m
# PSA_POSTGRES_IMAGE=postgres:17-alpine@sha256:<digest>

# Local backups (edge-backup service).
EDGE_BACKUP_INTERVAL_HOURS=24
EDGE_BACKUP_RETENTION=7

# Outbound proxy, if this host reaches the Internet through one.
# HTTPS_PROXY=http://proxy.example.internal:3128
# NO_PROXY=localhost,127.0.0.1,edge-postgres
