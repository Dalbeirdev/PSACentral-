# PSA Control Center — containerized Control Plane. `pnpm cp:setup` generates a real .env with random
# secrets (gitignored, never printed). For staging/production inject these from a secret manager and
# set APP_ENV accordingly: the API then refuses http origins, optional MFA, seed passwords and an
# unpinned edge image at boot (see docs/ENVIRONMENTS.md).
VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=info
OPENAPI_ENABLED=false
AUTH_MFA_REQUIRED=false

# Published on loopback only (put a TLS reverse proxy in front for anything beyond a workstation).
WEB_PORT=3410
API_PORT=4410
APP_ALLOWED_ORIGINS=http://localhost:3410,http://127.0.0.1:3410

# Agent gateway: the only listener edge agents reach (mutual TLS). Must be the address appliances can
# route to — the host's LAN address for workstations, a public DNS name in staging/production.
AGENT_GATEWAY_BIND=0.0.0.0
AGENT_GATEWAY_PORT=8643
AGENT_GATEWAY_URL=https://<host address>:8643
EDGE_HEARTBEAT_SECONDS=60

# Standard PSA Edge image referenced by generated packages (digest required in staging/production).
EDGE_IMAGE_REPOSITORY=psacc/psa-edge
EDGE_IMAGE_VERSION=0.1.0
EDGE_IMAGE_DIGEST=

# PostgreSQL (never published). Three roles: superuser bootstrap, schema owner, least-privilege app login.
POSTGRES_PASSWORD=<generated>
PSACC_OWNER_PASSWORD=<generated>
PSACC_APP_PASSWORD=<generated>

# Secrets (base64): CSRF HMAC key and the AES-256-GCM key for secrets at rest.
CSRF_SECRET=<base64, >= 32 bytes>
DATA_ENCRYPTION_KEY=<base64, exactly 32 bytes>

# First organization and administrator, created once by `pnpm cp:bootstrap`.
BOOTSTRAP_ORG_NAME=PSA Control Center
BOOTSTRAP_ORG_SLUG=control-plane
BOOTSTRAP_ADMIN_EMAIL=admin@control-plane.local
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=<generated; change after first sign-in>
